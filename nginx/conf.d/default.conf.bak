# ================================
# HTTP 站点配置 - aizhao.icu / api.aizhao.icu
# ================================

# ========== API 子域名 ==========
server {
    listen 80;
    listen [::]:80;
    server_name api.aizhao.icu;
    set $cors_origin "";
    if ($http_origin ~* "^https?://(localhost:3000|aizhao\\.icu|www\\.aizhao\\.icu|admin\\.aizhao\\.icu)$") {
        set $cors_origin $http_origin;
    }
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
        try_files $uri =404;
    }

    access_log /var/log/nginx/api.aizhao.icu.access.log main;
    error_log /var/log/nginx/api.aizhao.icu.error.log warn;

    location / {
        if ($request_method = OPTIONS) {
            return 204;
        }
        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        limit_req zone=api_limit burst=20 nodelay;
        limit_conn conn_limit 10;

        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location /health {
        proxy_pass http://backend_pool/health;
        access_log off;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.aizhao.icu;
    set $cors_origin "";
    if ($http_origin ~* "^https?://(localhost:3000|aizhao\\.icu|www\\.aizhao\\.icu|admin\\.aizhao\\.icu)$") {
        set $cors_origin $http_origin;
    }
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;

    ssl_certificate /etc/nginx/ssl/aizhao.icu/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/aizhao.icu/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        if ($request_method = OPTIONS) {
            return 204;
        }
        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=api_limit burst=20 nodelay;
        limit_conn conn_limit 10;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location /health {
        proxy_pass http://backend_pool/health;
        access_log off;
    }
}

# ========== 主站占位 ==========
server {
    listen 80;
    listen [::]:80;
    server_name aizhao.icu www.aizhao.icu admin.aizhao.icu;
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
        try_files $uri =404;
    }

    access_log /var/log/nginx/aizhao.icu.access.log main;
    error_log /var/log/nginx/aizhao.icu.error.log warn;

    location / {
        return 200 "AI衣柜前端尚未部署，API可通过 https://api.aizhao.icu 访问。\n";
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name aizhao.icu www.aizhao.icu admin.aizhao.icu;

    ssl_certificate /etc/nginx/ssl/aizhao.icu/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/aizhao.icu/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        return 200 "AI衣柜前端尚未部署，API可通过 https://api.aizhao.icu 访问.\n";
    }

    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
        try_files $uri =404;
    }
}
